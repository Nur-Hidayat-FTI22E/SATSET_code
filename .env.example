# SATSET Environment Configuration
# Generated on 2026-09-07

# ============================================================
# MQTT (Mosquitto)
# ============================================================
MQTT_HOST=localhost
MQTT_PORT=1883

# ============================================================
# InfluxDB
# ============================================================
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=satset-lab
INFLUXDB_BUCKET=satset
INFLUXDB_TOKEN=your_super_secret_influx_token_here

# ============================================================
# SNN Brain
# ============================================================
THREAT_THRESHOLD=0.6
INFERENCE_INTERVAL=1.0
SNN_MODEL_PATH=/brain/model/snn_model.pt
SNN_SCALER_PATH=/brain/model/snn_model_scaler.pkl

# ============================================================
# Self-Healing
# ============================================================
CONTAINER_NAME=satset-mosquitto
BASE_COOLDOWN=15.0
MAX_COOLDOWN=120.0
