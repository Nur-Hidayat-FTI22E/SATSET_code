    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "🔍 Network Layer Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "PF51A078FBCCC1962" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 500 }] },
          "unit": "pps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "query": "from(bucket: \"satset\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"network_stats\")\n  |> filter(fn: (r) => r._field == \"packet_rate\")\n  |> aggregateWindow(every: 1s, fn: mean)",
          "refId": "A"
        }
      ],
      "title": "📦 MQTT Packet Rate (pps)",
      "type": "timeseries"
